+// Local patch: only the read guard's question may reach the parent, at any nesting depth.
+// The whole title, the session-name prefixes and the guard's options must match, because a
+// model-written question (ask_user_question's select fallback) can copy any single line.
+const FORWARDED_TITLE =
+  /^(\[[A-Za-z0-9._-]+(#[0-9a-f]{8})?\] )*Allow \S+ outside current directory\?\n\nPath: [^\n]*\nCWD: [^\n]*$/;
+// The guard asks Yes/No, or Yes once / this file / an optional directory / No.
+const FORWARDED_DIR_OPTION = /^Yes, everything under [^\n]+ for the session$/;
+const isGuardOptions = (o: string[]) =>
+  (o.length === 2 && o[0] === "Yes" && o[1] === "No") ||
+  ((o.length === 3 || o.length === 4) &&
+    o[0] === "Yes, once" &&
+    o[1] === "Yes, this file for the session" &&
+    o[o.length - 1] === "No" &&
+    (o.length === 3 || FORWARDED_DIR_OPTION.test(o[2])));
+// An unanswered forwarded question resolves as "no answer", which the guard treats as No.
+const SUBAGENT_PROMPT_TIMEOUT_MS = 10 * 60_000;
+const IDLE_POLL_MS = 1_000;
+
+/**
+ * The UI a subagent's extensions see when the parent has one. Only the read guard's
+ * outside-cwd question goes to the parent's pane, named after the subagent, and only while
+ * the parent is busy: an idle pane would take the keypress meant for its editor. Every
+ * other dialog is refused and every other call stays silent, as pi's no-op UI does, so a
+ * subagent can neither ask for more nor redraw the parent's screen.
+ */
+export function promptOnlyUI(
+  parent: ExtensionUIContext,
+  name: string,
+  isParentIdle: () => boolean,
+  signal?: AbortSignal,
+): ExtensionUIContext {
+  // A parent whose context is gone counts as idle.
+  const parentIdle = () => {
+    try {
+      return isParentIdle();
+    } catch {
+      return true;
+    }
+  };
+  return {
+    select: async (title, options, opts) => {
+      const guardShaped =
+        FORWARDED_TITLE.test(title) &&
+        isGuardOptions(options);
+      if (!guardShaped || parentIdle()) return undefined;
+      const signals = [signal, opts?.signal].filter((s): s is AbortSignal => s !== undefined);
+      if (signals.some((s) => s.aborted)) return undefined;
+      const closeOnIdle = new AbortController();
+      const poll = setInterval(() => {
+        if (parentIdle()) closeOnIdle.abort();
+      }, IDLE_POLL_MS);
+      try {
+        return await parent.select(`[${name}] ${title}`, options, {
+          ...opts,
+          timeout: SUBAGENT_PROMPT_TIMEOUT_MS,
+          signal: AbortSignal.any([closeOnIdle.signal, ...signals]),
+        });
+      } finally {
+        clearInterval(poll);
+      }
+    },
+    confirm: async () => false,
+    input: async () => undefined,
+    notify: () => {},
+    onTerminalInput: () => () => {},
+    setStatus: () => {},
+    setWorkingMessage: () => {},
+    setWorkingVisible: () => {},
+    setWorkingIndicator: () => {},
+    setHiddenThinkingLabel: () => {},
+    setWidget: () => {},
+    setFooter: () => {},
+    setHeader: () => {},
+    setTitle: () => {},
+    custom: async () => undefined as never,
+    pasteToEditor: () => {},
+    setEditorText: () => {},
+    getEditorText: () => "",
+    editor: async () => undefined,
+    addAutocompleteProvider: () => {},
+    setEditorComponent: () => {},
+    getEditorComponent: () => undefined,
+    get theme() {
+      return parent.theme;
+    },
+    getAllThemes: () => [],
+    getTheme: () => undefined,
+    setTheme: () => ({ success: false, error: "UI not available" }),
+    getToolsExpanded: () => false,
+    setToolsExpanded: () => {},
+  };
 }
 
