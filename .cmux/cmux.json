{
  "commands": [
    {
      "name": "pi Team",
      "description": "Workers use the implementation model from Model roles in .pi/SYSTEM.md; update --model when the roles change.",
      "keywords": ["team", "fleet", "workers"],
      "workspace": {
        "name": "pi-team",
        "cwd": ".",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "worker-1",
                    "command": "npm run agent -- --new-session --model anthropic/claude-sonnet-5-5:medium",
                    "focus": true
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal",
                    "name": "worker-2",
                    "command": "npm run agent -- --new-session --model anthropic/claude-sonnet-5-5:medium"
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
