{
    "name": "pi-coding-agent",
    "version": "1.0.0",
    "description": "Project-local PI coding agent parity stack",
    "main": "src/main.ts",
    "scripts": {
        "postinstall": "tsx scripts/patch-retry.ts",
        "predev": "bash scripts/headroom-up.sh --quiet",
        "dev": "tsx watch src/main.ts",
        "preagent": "bash scripts/headroom-up.sh --quiet",
        "agent": "tsx src/main.ts",
        "smoke": "tsx scripts/smoke.ts",
        "pi:patch-retry": "tsx scripts/patch-retry.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "pi:pull-global": "tsx scripts/sync-pi-config.ts pull",
        "pi:sync-global": "tsx scripts/sync-pi-config.ts push",
        "headroom:up": "bash scripts/headroom-up.sh",
        "headroom:down": "docker compose -f headroom-compose.yml down"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "dependencies": {
        "@earendil-works/pi-agent-core": "^0.87.0",
        "@earendil-works/pi-ai": "^0.87.0",
        "@earendil-works/pi-coding-agent": "^0.87.0",
        "@earendil-works/pi-tui": "^0.87.0",
        "@sinclair/typebox": "^0.34.49",
        "chalk": "^5.6.2"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "@types/semver": "^7.8.0",
        "@vitest/coverage-v8": "^4.1.2",
        "diff2html": "3.4.56",
        "semver": "^7.7.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
